{
  "compilerOptions": {
    "target": "es2022",
    "module": "NodeNext",
    "isolatedModules": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "sourceMap": false
  },
  "include": [
    "src/*.ts",
    "esbuild.config.ts",
    "eslint.config.ts",
    "types/*.d.ts"
  ]
}
